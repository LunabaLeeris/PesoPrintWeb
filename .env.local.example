# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=your-storage-bucket-name

# Raspberry Pi Print Server Configuration (Local WiFi IP or Cloudflare tunnel)
NEXT_PUBLIC_PRINT_SERVER_URL=http://your-pi-ip:5000

# Kiosk Secret Key for Raspberry Pi Express Server Authentication
KIOSK_SECRET_KEY=your-kiosk-secret-key-here
NEXT_PUBLIC_KIOSK_SECRET_KEY=your-kiosk-secret-key-here

# Set to 'true' to bypass all health checks for local development/testing without a physical printer
DISABLE_HEALTH_CHECKS=false
NEXT_PUBLIC_DISABLE_HEALTH_CHECKS=false

# Set to 'true' to bypass payment processing and immediately succeed when tapping icons
DISABLE_PAYMENT=false
NEXT_PUBLIC_DISABLE_PAYMENT=false
